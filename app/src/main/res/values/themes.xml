<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.PMDM_P1_PaulaRivasGonzalez" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/color_primario</item>
    </style>
    <style name="Theme.PMDM_P1_PaulaRivasGonzalez" parent="Base.Theme.PMDM_P1_PaulaRivasGonzalez" />

    <style name="EstiloTituloPrincipal">
        <item name="android:textSize">20dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_texto_titulo</item>
    </style>

    <style name="EstiloTituloLista">
        <item name="android:textSize">20dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_secundario</item>
    </style>

    <style name="EstiloBotonesPrincipales">
        <item name="android:textSize">16dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_texto_botones_princial</item>
        <item name="android:backgroundTint">@color/color_primario</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="EstiloBotonesSecundorios">
        <item name="android:textSize">16dp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/color_primario</item>
        <item name="android:backgroundTint">@color/color_detalles</item>
        <item name="strokeColor">@color/color_primario</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:padding">12dp</item>
    </style>


</resources>